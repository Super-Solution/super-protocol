          }
        },
        "negative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[;{}<>\\\\]|/\\*|[uU][rR][lL]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]"
          }
        },
        "warning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[;{}<>\\\\]|/\\*|[uU][rR][lL]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]"
          }
        },
        "info": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[;{}<>\\\\]|/\\*|[uU][rR][lL]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]"
          }
        },
        "font-sans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[;{}<>\\\\]|/\\*|[uU][rR][lL]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]"
          }
        },
        "font-mono": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[;{}<>\\\\]|/\\*|[uU][rR][lL]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]"
          }
        },
        "radius": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[;{}<>\\\\]|/\\*|[uU][rR][lL]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]"
          }
        }
