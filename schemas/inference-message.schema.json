{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Super-Solution/super-protocol/main/schemas/inference-message.schema.json",
  "title": "Inference message",
  "description": "One message of an inference request: a system, user, assistant or tool message. Structure only. A value this schema accepts can still be refused by the validator: rules across fields (duplicates, a tool result that answers no call, ordering, limits that count UTF-16 units) are checked by the validators and pinned by conformance/protocol.v1.json, not here. A value the validators accept always validates.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "const": "system"
        },
        "content": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "const": "user"
        },
        "content": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "const": "user"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentPart"
          },
          "minItems": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "const": "assistant"
        },
        "content": {
          "type": "string"
        },
        "tool_calls": false
      }
    },
    {
      "type": "object",
      "required": [
        "role",
        "tool_calls"
      ],
      "properties": {
        "role": {
          "const": "assistant"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          },
          "minItems": 1
        },
        "content": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "role",
        "tool_call_id",
        "content"
      ],
      "properties": {
        "role": {
          "const": "tool"
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "toolCall": {
      "type": "object",
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-]{1,64}$"
        },
        "arguments": {
          "type": "string"
        }
      }
    },
    "contentPart": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "url": {
              "type": "string",
              "pattern": "^(?:[hH][tT][tT][pP][sS]:|data:image/(?:png|jpeg|gif|webp);base64,[A-Za-z0-9+/]+={0,2}$)"
            },
            "detail": {
              "enum": [
                "auto",
                "low",
                "high"
              ]
            }
          }
        }
      ]
    },
    "inferenceMessage": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "const": "system"
            },
            "content": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "const": "user"
            },
            "content": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "const": "user"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contentPart"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "const": "assistant"
            },
            "content": {
              "type": "string"
            },
            "tool_calls": false
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "tool_calls"
          ],
          "properties": {
            "role": {
              "const": "assistant"
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/toolCall"
              },
              "minItems": 1
            },
            "content": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role",
            "tool_call_id",
            "content"
          ],
          "properties": {
            "role": {
              "const": "tool"
            },
            "tool_call_id": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string"
            },
            "is_error": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "meters": {
      "type": "object",
      "required": [
        "input",
        "cached",
        "cache_write",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "images": {
          "type": "integer",
          "minimum": 0
        },
        "video_ms": {
          "type": "integer",
          "minimum": 0
        },
        "audio_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inferenceUsage": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "meters": {
          "$ref": "#/$defs/meters"
        }
      }
    }
  }
}
