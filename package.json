{
  "name": "super-protocol-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Super Protocol: the Apache-2.0 contract and conformance data shared by the Super Solution libs, with TypeScript, Go and Python implementations.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm --filter @supersolutions/super-protocol build",
    "test": "pnpm --filter @supersolutions/super-protocol test",
    "typecheck": "pnpm --filter @supersolutions/super-protocol typecheck",
    "conformance:export": "node scripts/export-conformance.mjs && node scripts/export-index.mjs",
    "schemas:export": "node scripts/export-schemas.mjs",
    "agent-loop:export": "node scripts/export-agent-loop.mjs",
    "check": "bash scripts/check-all.sh"
  }
}
