{
  "name": "@supersolutions/super-protocol",
  "version": "0.4.1",
  "description": "Apache-2.0 shared protocol for the Super Solution libs: plugin manifest, chat plugin contract, inference gateway and editor card types. Types and validators only, no runtime dependencies.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "homepage": "https://github.com/Super-Solution/super-protocol/tree/main/implementations/typescript#readme",
  "bugs": {
    "url": "https://github.com/Super-Solution/super-protocol/issues"
  },
  "keywords": [
    "protocol",
    "plugin",
    "contracts",
    "agent",
    "chat"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./placement": {
      "types": "./dist/placement.d.ts",
      "import": "./dist/placement.js",
      "default": "./dist/placement.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "default": "./dist/chat.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "import": "./dist/run.js",
      "default": "./dist/run.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js",
      "default": "./dist/chart.js"
    },
    "./ref": {
      "types": "./dist/ref.d.ts",
      "import": "./dist/ref.js",
      "default": "./dist/ref.js"
    },
    "./plot": {
      "types": "./dist/plot.d.ts",
      "import": "./dist/plot.js",
      "default": "./dist/plot.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./mapping": {
      "types": "./dist/mapping.d.ts",
      "import": "./dist/mapping.js",
      "default": "./dist/mapping.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./interop/ag-ui": {
      "types": "./dist/interop/ag-ui.d.ts",
      "import": "./dist/interop/ag-ui.js",
      "default": "./dist/interop/ag-ui.js"
    },
    "./interop/ai-sdk": {
      "types": "./dist/interop/ai-sdk.d.ts",
      "import": "./dist/interop/ai-sdk.js",
      "default": "./dist/interop/ai-sdk.js"
    },
    "./interop/mcp": {
      "types": "./dist/interop/mcp.d.ts",
      "import": "./dist/interop/mcp.js",
      "default": "./dist/interop/mcp.js"
    },
    "./interop/otel": {
      "types": "./dist/interop/otel.d.ts",
      "import": "./dist/interop/otel.js",
      "default": "./dist/interop/otel.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-protocol.git",
    "directory": "implementations/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.4",
    "@types/node": "^22.10.2",
    "ai": "7.0.168",
    "ajv": "8.17.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "4.1.8"
  }
}
